# 容器化部署引导配置模板：复制为 .env.deploy 后填写（.env.deploy 已被 git 忽略）。
#
# 只放两件事：
#   1. 连接 Nacos 所必需的 NACOS_* 引导参数；
#   2. 容器基础环境（时区）。
# 其余业务配置（OneBot 连接、数据库、插件参数）一律在 Nacos 上维护，
# 清单见 README「Nacos 配置说明」。DRIVER 已在镜像内固定，无需在此配置。

# ---------- Nacos 引导配置 ----------
# Nacos 服务地址，多个用逗号分隔，例如 127.0.0.1:8848
NACOS_SERVER_ADDR=
# 命名空间 ID，留空表示 public
NACOS_NAMESPACE=
# 配置分组
NACOS_GROUP=DEFAULT_GROUP
# 按声明顺序拉取，后者覆盖前者的同名键
NACOS_DATA_IDS=sinbot-common.properties,sinbot-team-manager.properties
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_TIMEOUT=10
# 拉取失败时是否降级为告警继续启动；false 表示快速失败（推荐）
NACOS_ALLOW_FAILURE=false

# ---------- 容器环境 ----------
TZ=Asia/Shanghai
