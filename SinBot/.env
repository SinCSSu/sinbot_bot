ENVIRONMENT=dev
DRIVER=~fastapi+~websockets
SQLALCHEMY_DATABASE_URL=sqlite+aiosqlite:///./sinbot.db
TEAM_MANAGER__LLM_BASE_URL=https://api.deepseek.com
