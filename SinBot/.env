# 本地只保留驱动声明与连接 Nacos 所需的引导配置。
# 业务配置（ENVIRONMENT / LOG_LEVEL / API_TIMEOUT / SQLALCHEMY_DATABASE_URL /
# ONEBOT_ACCESS_TOKEN / ONEBOT_WS_URLS / TEAM_MANAGER__*）全部由 Nacos 下发，
# 清单见 README「Nacos 配置说明」。

DRIVER=~fastapi+~websockets

# ---------- Nacos 引导配置 ----------
# 以上每项都可以改用系统环境变量提供（系统环境变量优先级更高），适合容器化部署。
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_DATA_IDS=sinbot-common.properties,sinbot-team-manager.properties
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_TIMEOUT=10
# 拉取失败时是否降级为告警继续启动；false 表示快速失败（推荐）
NACOS_ALLOW_FAILURE=false
