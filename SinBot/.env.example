# 引导配置模板：复制为 .env 后按实际环境填写（.env 已被 git 忽略，不会提交）。
#
# 本文件只含两件事：
#   1. DRIVER —— 必须在 nonebot.init() 之前确定，故保留在本地；
#   2. NACOS_* —— 连接 Nacos 所必需，不可能从 Nacos 自身获取。
# 其余全部配置请到 Nacos 上维护，清单见 README「Nacos 配置说明」。

DRIVER=~fastapi+~websockets

# ---------- Nacos 引导配置 ----------
# 每一项都可以改用系统环境变量提供（系统环境变量优先级更高），适合容器化部署：
#   必填：NACOS_SERVER_ADDR、NACOS_DATA_IDS
#   选填：NACOS_NAMESPACE（默认 public）、NACOS_GROUP（默认 DEFAULT_GROUP）、
#         NACOS_USERNAME / NACOS_PASSWORD 或 NACOS_AK / NACOS_SK（无鉴权时留空）、
#         NACOS_TIMEOUT（默认 10 秒）、NACOS_ALLOW_FAILURE（默认 false）

# Nacos 服务地址，多个用逗号分隔，例如 127.0.0.1:8848
NACOS_SERVER_ADDR=
# 命名空间 ID，留空表示 public
NACOS_NAMESPACE=
# 配置分组
NACOS_GROUP=DEFAULT_GROUP
# 按声明顺序拉取，后者覆盖前者的同名键
NACOS_DATA_IDS=sinbot-common.properties,sinbot-team-manager.properties
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_TIMEOUT=10
# 拉取失败时是否降级为告警继续启动；false 表示快速失败（推荐）
NACOS_ALLOW_FAILURE=false
